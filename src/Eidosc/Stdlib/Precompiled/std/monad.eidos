Monad :: module {

    export Monad[M: kind2] :: trait {
        pure[A] :: A -> M[A]
        bind[A, B, E: effects] :: M[A] -> (A -> M[B] need E) -> M[B] need E compiler(role: "elaborator.do.bind")
    }

    export map[A, B, M: kind2 : Monad[M], E: effects] :: M[A] -> (A -> B need E) -> M[B] need E
    {
        values, f => Monad.bind(values, value => value |> f |> Monad.pure)
    }

    export flat_map[A, B, M: kind2 : Monad[M], E: effects] :: M[A] -> (A -> M[B] need E) -> M[B] need E
    {
        values, f => Monad.bind(values, f)
    }

    export join[A, M: kind2 : Monad[M]] :: M[M[A]] -> M[A]
    {
        values => Monad.bind(values, inner => inner)
    }

    export flatten[A, M: kind2 : Monad[M]] :: M[M[A]] -> M[A]
    {
        values => Monad.join(values)
    }

    export ap[A, B, M: kind2 : Monad[M]] :: M[A -> B] -> M[A] -> M[B]
    {
        functions, values => Monad.bind(functions, f => Monad.map(values, f))
    }

    export map2[A, B, C, M: kind2 : Monad[M], E: effects] :: M[A] -> M[B] -> (A -> B -> C need E) -> M[C] need E
    {
        left, right, f => Monad.bind(left, a => Monad.map(right, f(a)))
    }

    export compose_k[A, B, C, M: kind2 : Monad[M], E1: effects, E2: effects] :: (A -> M[B] need E1) -> (B -> M[C] need E2) -> A -> M[C] need E1, E2
    {
        f, g, value => Monad.bind(value |> f, g)
    }

    export void[A, M: kind2 : Monad[M]] :: M[A] -> M[Unit]
    {
        values => Monad.map(values, _ => ())
    }
}
