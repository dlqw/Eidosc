Shared :: module {
    import Traits

    export Shared[T] :: type {
    }


    export new[T] :: T -> Shared[T] compiler(intrinsic: "shared_new");



    export borrow[T] :: Ref[Shared[T]] -> Ref[T] compiler(intrinsic: "shared_borrow");



    export clone[T] :: Ref[Shared[T]] -> Shared[T] compiler(intrinsic: "shared_clone");


    export CloneSharedT :: instance Traits.Clone {

        clone[T] :: Ref[Shared[T]] -> Shared[T] compiler(intrinsic: "shared_clone");

    }


    export ptr_eq[T] :: Ref[Shared[T]] -> Ref[Shared[T]] -> Bool compiler(intrinsic: "shared_ptr_eq");

}
