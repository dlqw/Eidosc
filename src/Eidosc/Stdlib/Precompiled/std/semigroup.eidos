Semigroup :: module {
    export Semigroup :: trait {
        append :: Self -> Self -> Self compiler(role: "operator.append")
    }

    export append3[T: Semigroup.Semigroup] :: T -> T -> T -> T
    {
        left, middle, right => left.append(middle).append(right)
    }

    export SemigroupInt :: instance Semigroup.Semigroup {
        append :: Int -> Int -> Int
            {
                left => right => left + right
            }
    }

    export SemigroupString :: instance Semigroup.Semigroup {
        append :: String -> String -> String
            {
                left => right => left ++ right
            }
    }

    export SemigroupSeq :: instance Semigroup.Semigroup {
        append[T] :: Seq[T] -> Seq[T] -> Seq[T]
            {
                left => right => [x | xs <- [left, right], x <- xs]
            }
    }
}
