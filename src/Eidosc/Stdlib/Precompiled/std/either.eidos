Either :: module {
    import Display
    import Functor
    import Applicative
    import Foldable
    import Monad
    import Traversable

    export Either[L, R] :: type { Left:: type(L), Right:: type(R) }
    export WithLeft[L, R] :: type = Either[L, R]

    right_wrap[L, R] :: R -> WithLeft[L, R]
     compiler(internal)
    {
        value => Right(value)
    }

    export is_left[L, R] :: Either[L, R] -> Bool
    {
        Left(_) => true,
        Right(_) => false
    }

    export is_right[L, R] :: Either[L, R] -> Bool
    {
        Left(_) => false,
        Right(_) => true
    }

    export map[L, R, U, F: effects] :: Either[L, R] -> (R -> U need F) -> Either[L, U] need F
    {
        Left(value) => _ => Left(value),
        Right(value) => f => Right(f(value))
    }

    export map_left[L, R, U, F: effects] :: Either[L, R] -> (L -> U need F) -> Either[U, R] need F
    {
        Left(value) => f => Left(f(value)),
        Right(value) => _ => Right(value)
    }

    export bimap[L, R, U, V, F1: effects, F2: effects] :: Either[L, R] -> (L -> U need F1) -> (R -> V need F2) -> Either[U, V] need F1, F2
    {
        Left(value) => left_fn => _ => Left(left_fn(value)),
        Right(value) => _ => right_fn => Right(right_fn(value))
    }

    export fold[L, R, U, F1: effects, F2: effects] :: Either[L, R] -> (L -> U need F1) -> (R -> U need F2) -> U need F1, F2
    {
        Left(value) => left_fn => _ => left_fn(value),
        Right(value) => _ => right_fn => right_fn(value)
    }

    export unwrap_or[L, R] :: Either[L, R] -> R -> R
    {
        Left(_) => fallback => fallback,
        Right(value) => _ => value
    }

    export FunctorEitherWithLeft[L] :: instance Functor.Functor[WithLeft[L]] {
        fmap[A, B, L, E: effects] :: WithLeft[L, A] -> (A -> B need E) -> WithLeft[L, B] need E
            {
                value, f => value.map(f)
            }
    }

    export ApplicativeEitherWithLeft[L] :: instance Applicative.Applicative[WithLeft[L]] {
        pure[A, L] :: A -> WithLeft[L, A]
            {
                value => Right(value)
            }
        apply[A, B, L, E: effects] :: WithLeft[L, A -> B need E] -> WithLeft[L, A] -> WithLeft[L, B] need E
            {
                Left(error), _ => Left(error),
                Right(_), Left(error) => Left(error),
                Right(f), Right(value) => Right(f(value))
            }
    }

    export MonadEitherWithLeft[L] :: instance Monad.Monad[WithLeft[L]] {
        pure[A, L] :: A -> WithLeft[L, A]
            {
                value => Right(value)
            }
        bind[A, B, L, E: effects] :: WithLeft[L, A] -> (A -> WithLeft[L, B] need E) -> WithLeft[L, B] need E
            {
                Left(error), _ => Left(error),
                Right(value), f => f(value)
            }
    }

    export FoldableEitherWithLeft[L] :: instance Foldable.Foldable[WithLeft[L]] {
        fold_left[A, B, L, E: effects] :: WithLeft[L, A] -> B -> (B -> A -> B need E) -> B need E
            {
                Left(_), initial, _ => initial,
                Right(value), initial, f => f(initial)(value)
            }
        fold_right[A, B, L, E: effects] :: WithLeft[L, A] -> B -> (A -> B -> B need E) -> B need E
            {
                Left(_), initial, _ => initial,
                Right(value), initial, f => f(value)(initial)
            }
    }

    export TraversableEitherWithLeft[L] :: instance Traversable.Traversable[WithLeft[L]] {
        traverse[A, B, G: kind2 : Applicative.Applicative[G], L, E: effects] :: WithLeft[L, A] -> (A -> G[B] need E) -> G[WithLeft[L, B]] need E
            {
                Left(error), _ => Traversable.lift_pure(Left(error)),
                Right(value), f => Traversable.map_applicative(Either.right_wrap)(f(value))
            }
    }

    export sequence[A, G: kind2 : Applicative.Applicative[G], L] :: WithLeft[L, G[A]] -> G[WithLeft[L, A]]
    {
        value => value.traverse(Traversable.identity_applicative)
    }

    export DisplayEither :: instance Display {
        display[L: Display, R: Display] :: Ref[Either[L, R]] -> String
            {
                value => match *value {
                    Left(inner) => "Left(" ++ Display.render(ref inner) ++ ")",
                    Right(inner) => "Right(" ++ Display.render(ref inner) ++ ")"
                }
            }
    }
}
