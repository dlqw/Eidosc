BinaryHeap :: module {
    import RuntimeArray
    import Seq
    import Option
    import Traits
    import TraitInvoke

    export BinaryHeap[T] :: type {items:: Seq[T]}

    export empty[T] :: Unit -> BinaryHeap[T]
    {
        _ => BinaryHeap{items: []}
    }

    export singleton[T] :: T -> BinaryHeap[T]
    {
        value => BinaryHeap{items: [value]}
    }

    export len[T] :: Ref[BinaryHeap[T]] -> Int
    {
        heap => match *heap {
            BinaryHeap{items: items} => Seq.len_ref(ref items)
        }
    }

    export is_empty[T] :: Ref[BinaryHeap[T]] -> Bool
    {
        heap => BinaryHeap.len(heap) == 0
    }

    export to_seq[T] :: BinaryHeap[T] -> Seq[T]
    {
        BinaryHeap{items: items} => items
    }

    export CloneBinaryHeapT :: instance Traits.Clone {
        clone[T: Traits.Clone] :: Ref[BinaryHeap[T]] -> BinaryHeap[T]
            {
                value => match *value {
                    BinaryHeap{items: items} => BinaryHeap{items: TraitInvoke.clone_value(ref items)}
                }
            }
    }


    parent_index :: Int -> Int
     compiler(internal)
{
        index => (index - 1) / 2
    }


    left_child_index :: Int -> Int
     compiler(internal)
{
        index => index * 2 + 1
    }


    right_child_index :: Int -> Int
     compiler(internal)
{
        index => index * 2 + 2
    }


    sift_up_from[T: Traits.Ord + Traits.Clone] :: Seq[T] -> Int -> Seq[T]
     compiler(internal)
{
        values => start => {
            mut heap := values
            mut index := start
            loop {
                if index <= 0 then { break } else {
                    parent := BinaryHeap.parent_index(index)
                    index_value := TraitInvoke.clone_value(ref heap[index])
                    parent_value := TraitInvoke.clone_value(ref heap[parent])
                    if index_value > parent_value then {
                        RuntimeArray.swap(mref heap, index, parent)
                        index := parent
                    } else { break }
                }
            }
            heap
        }
    }


    sift_down_from[T: Traits.Ord + Traits.Clone] :: Seq[T] -> Int -> Seq[T]
     compiler(internal)
{
        values => start => {
            len := Seq.len_ref(ref values)
            mut heap := values
            mut index := start
            loop {
                left := BinaryHeap.left_child_index(index)
                if left >= len then { break } else {
                    right := BinaryHeap.right_child_index(index)
                    mut largest := left
                    right_value := if right < len then { TraitInvoke.clone_value(ref heap[right]) }
                        else { TraitInvoke.clone_value(ref heap[left]) }
                    left_value := TraitInvoke.clone_value(ref heap[left])
                    if right < len && right_value > left_value then {
                        largest := right
                    } else { () }
                    largest_value := TraitInvoke.clone_value(ref heap[largest])
                    index_value := TraitInvoke.clone_value(ref heap[index])
                    if largest_value > index_value then {
                        RuntimeArray.swap(mref heap, largest, index)
                        index := largest
                    } else { break }
                }
            }
            heap
        }
    }

    export push[T: Traits.Ord + Traits.Clone] :: BinaryHeap[T] -> T -> BinaryHeap[T]
    {
        BinaryHeap{items: items} => value => {
            pushed := RuntimeArray.push(items)(value)
            index := Seq.len_ref(ref pushed) - 1
            BinaryHeap{items: BinaryHeap.sift_up_from(pushed)(index)}
        }
    }

    heapify_from[T: Traits.Ord + Traits.Clone] :: Seq[T] -> Int -> Seq[T]
     compiler(internal)
    {
        values => index => if index < 0 then { values }
            else {
                next := BinaryHeap.sift_down_from(values)(index)
                BinaryHeap.heapify_from(next)(index - 1)
            }
    }

    export from_seq[T: Traits.Ord + Traits.Clone] :: Seq[T] -> BinaryHeap[T]
    {
        values => {
            last_parent := (Seq.len_ref(ref values) / 2) - 1
            BinaryHeap{items: BinaryHeap.heapify_from(values)(last_parent)}
        }
    }

    export peek[T] :: BinaryHeap[T] -> Option[T]
    {
        BinaryHeap{items: []} => None(),
        BinaryHeap{items: [top, ..]} => Some(top)
    }

    export pop[T: Traits.Ord + Traits.Clone] :: BinaryHeap[T] -> Option[(T, BinaryHeap[T])]
    {
        BinaryHeap{items: []} => None(),
        BinaryHeap{items: [top, ..rest]} => Some((top, BinaryHeap.from_seq(rest)))
    }
}
