Stack :: module {
    import Seq
    import Option

    export Stack[T] :: type {items:: Seq[T]}

    export empty[T] :: Unit -> Stack[T]
    {
        _ => Stack{items: []}
    }

    export singleton[T] :: T -> Stack[T]
    {
        value => Stack{items: [value]}
    }

    export from_seq[T] :: Seq[T] -> Stack[T]
    {
        values => Stack{items: Seq.reverse(values)}
    }

    export len[T] :: Ref[Stack[T]] -> Int
    {
        stack => match *stack {
            Stack{items: items} => Seq.len(ref items)
        }
    }

    export is_empty[T] :: Ref[Stack[T]] -> Bool
    {
        stack => Stack.len(stack) == 0
    }

    export push[T] :: Stack[T] -> T -> Stack[T]
    {
        Stack{items: items} => value => Stack{items: [value, ..items]}
    }

    export peek[T] :: Stack[T] -> Option[T]
    {
        Stack{items: [value, ..]} => Some(value),
        _ => None()
    }

    export pop[T] :: Stack[T] -> Option[(T, Stack[T])]
    {
        Stack{items: [value, ..rest]} => Some((value, Stack{items: rest})),
        _ => None()
    }

    export to_seq[T] :: Stack[T] -> Seq[T]
    {
        Stack{items: items} => Seq.reverse(items)
    }
}
