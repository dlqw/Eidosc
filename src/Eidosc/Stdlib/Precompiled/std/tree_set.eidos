TreeSet :: module {
    import Seq
    import Option
    import Traits
    import TreeMap

    export TreeSet[K] :: type {inner:: TreeMap[K, Bool]}

    export empty[K] :: Unit -> TreeSet[K]
    {
        _ => TreeSet{inner: TreeMap.empty(())}
    }

    export singleton[K] :: K -> TreeSet[K]
    {
        key => TreeSet{inner: TreeMap.singleton(key)(true)}
    }

    export from_seq[K: Traits.Ord + Traits.Clone] :: Seq[K] -> TreeSet[K]
    {
        values => values.fold_left(TreeSet.empty(()), set => key => set.insert(key))
    }

    export len[K] :: Ref[TreeSet[K]] -> Int
    {
        set => match *set {
            TreeSet{inner: TreeMap.Empty()} => 0,
            TreeSet{inner: TreeMap.Node{size: size, key: _, value: _, left: _, right: _, height: _}} => size
        }
    }

    export is_empty[K] :: Ref[TreeSet[K]] -> Bool
    {
        set => TreeSet.len(set) == 0
    }

    export insert[K: Traits.Ord + Traits.Clone] :: TreeSet[K] -> K -> TreeSet[K]
    {
        TreeSet{inner: inner} => key => TreeSet{inner: TreeMap.insert(inner)(key)(true)}
    }

    export remove[K: Traits.Ord + Traits.Clone] :: TreeSet[K] -> K -> TreeSet[K]
    {
        TreeSet{inner: inner} => key => TreeSet{inner: TreeMap.remove(inner)(key)}
    }

    export contains[K: Traits.Ord + Traits.Clone] :: TreeSet[K] -> K -> Bool
    {
        TreeSet{inner: inner} => key => TreeMap.contains_key(inner)(key)
    }

    export to_seq[K] :: TreeSet[K] -> Seq[K]
    {
        TreeSet{inner: inner} => TreeMap.keys(inner)
    }

    export union[K: Traits.Ord + Traits.Clone] :: TreeSet[K] -> TreeSet[K] -> TreeSet[K]
    {
        left, right => right.to_seq().fold_left(left, set => key => set.insert(key))
    }

    export intersection[K: Traits.Ord + Traits.Clone] :: TreeSet[K] -> TreeSet[K] -> TreeSet[K]
    {
        left, right => left.to_seq().fold_left(TreeSet.empty(()), acc => key =>
            if right.contains(key) then { acc.insert(key) } else { acc })
    }

    export difference[K: Traits.Ord + Traits.Clone] :: TreeSet[K] -> TreeSet[K] -> TreeSet[K]
    {
        left, right => left.to_seq().fold_left(TreeSet.empty(()), acc => key =>
            if right.contains(key) then { acc } else { acc.insert(key) })
    }
}
