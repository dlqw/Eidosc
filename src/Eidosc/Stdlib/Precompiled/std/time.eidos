Time :: module {
    export Duration :: type {seconds:: Int}




    time_now :: Unit -> Int compiler(internal, intrinsic: "time_now") need io;





    time_now_ms :: Unit -> Int compiler(internal, intrinsic: "time_now_ms") need io;




    time_year :: Int -> Int compiler(internal, intrinsic: "time_year");




    time_month :: Int -> Int compiler(internal, intrinsic: "time_month");




    time_day :: Int -> Int compiler(internal, intrinsic: "time_day");




    time_hour :: Int -> Int compiler(internal, intrinsic: "time_hour");




    time_minute :: Int -> Int compiler(internal, intrinsic: "time_minute");




    time_second :: Int -> Int compiler(internal, intrinsic: "time_second");


    // 核心操作
    export now :: Unit -> Int need io { _ => time_now() }
    export now_ms :: Unit -> Int need io { _ => time_now_ms() }

    // 字段提取
    export year :: Int -> Int { ts => time_year(ts) }
    export month :: Int -> Int { ts => time_month(ts) }
    export day :: Int -> Int { ts => time_day(ts) }
    export hour :: Int -> Int { ts => time_hour(ts) }
    export minute :: Int -> Int { ts => time_minute(ts) }
    export second :: Int -> Int { ts => time_second(ts) }

    // Duration 算术
    export add_seconds :: Int -> Int -> Int { ts => s => ts + s }
    export sub_seconds :: Int -> Int -> Int { ts => s => ts - s }
    export diff_seconds :: Int -> Int -> Int { a => b => b - a }

    export add_minutes :: Int -> Int -> Int { ts => minutes => Time.add_seconds(ts)(minutes * 60) }
    export add_hours :: Int -> Int -> Int { ts => hours => Time.add_seconds(ts)(hours * 3600) }
    export add_days :: Int -> Int -> Int { ts => days => Time.add_seconds(ts)(days * 86400) }
    export sub_minutes :: Int -> Int -> Int { ts => minutes => Time.sub_seconds(ts)(minutes * 60) }
    export sub_hours :: Int -> Int -> Int { ts => hours => Time.sub_seconds(ts)(hours * 3600) }
    export sub_days :: Int -> Int -> Int { ts => days => Time.sub_seconds(ts)(days * 86400) }

    export duration_seconds :: Int -> Duration
    {
        value => Duration{seconds: value}
    }

    export duration_minutes :: Int -> Duration
    {
        value => Duration{seconds: value * 60}
    }

    export duration_hours :: Int -> Duration
    {
        value => Duration{seconds: value * 3600}
    }

    export duration_days :: Int -> Duration
    {
        value => Duration{seconds: value * 86400}
    }

    export duration_weeks :: Int -> Duration
    {
        value => Duration{seconds: value * 604800}
    }

    export to_seconds :: Duration -> Int
    {
        Duration{seconds: value} => value
    }

    export to_minutes :: Duration -> Int
    {
        Duration{seconds: value} => value / 60
    }

    export to_hours :: Duration -> Int
    {
        Duration{seconds: value} => value / 3600
    }

    export to_days :: Duration -> Int
    {
        Duration{seconds: value} => value / 86400
    }

    export duration_add :: Duration -> Duration -> Duration
    {
        left => right => Duration{seconds: Time.to_seconds(left) + Time.to_seconds(right)}
    }

    export duration_sub :: Duration -> Duration -> Duration
    {
        left => right => Duration{seconds: Time.to_seconds(left) - Time.to_seconds(right)}
    }

    export duration_negate :: Duration -> Duration
    {
        Duration{seconds: value} => Duration{seconds: 0 - value}
    }

    export duration_abs :: Duration -> Duration
    {
        Duration{seconds: value} =>
            if value < 0 then { Duration{seconds: 0 - value} } else { Duration{seconds: value} }
    }

    export duration_scale :: Duration -> Int -> Duration
    {
        Duration{seconds: value} => factor => Duration{seconds: value * factor}
    }

    export duration_min :: Duration -> Duration -> Duration
    {
        Duration{seconds: left} => Duration{seconds: right} =>
            if left <= right then { Duration{seconds: left} } else { Duration{seconds: right} }
    }

    export duration_max :: Duration -> Duration -> Duration
    {
        Duration{seconds: left} => Duration{seconds: right} =>
            if left >= right then { Duration{seconds: left} } else { Duration{seconds: right} }
    }

    export duration_clamp :: Duration -> Duration -> Duration -> Duration
    {
        duration => low => high => Time.duration_min(Time.duration_max(duration)(low))(high)
    }

    export duration_is_zero :: Duration -> Bool
    {
        Duration{seconds: value} => value == 0
    }

    export duration_is_positive :: Duration -> Bool
    {
        Duration{seconds: value} => value > 0
    }

    export duration_is_negative :: Duration -> Bool
    {
        Duration{seconds: value} => value < 0
    }

    export add_duration :: Int -> Duration -> Int
    {
        ts => duration => ts + Time.to_seconds(duration)
    }

    export sub_duration :: Int -> Duration -> Int
    {
        ts => duration => ts - Time.to_seconds(duration)
    }

    export diff_duration :: Int -> Int -> Duration
    {
        start => finish => Duration{seconds: finish - start}
    }

    // 便捷：时间是否在某个范围内
    export is_after :: Int -> Int -> Bool { ts => other => ts > other }
    export is_before :: Int -> Int -> Bool { ts => other => ts < other }

    export min_timestamp :: Int -> Int -> Int
    {
        left => right => if left <= right then { left } else { right }
    }

    export max_timestamp :: Int -> Int -> Int
    {
        left => right => if left >= right then { left } else { right }
    }

    export is_between_inclusive :: Int -> Int -> Int -> Bool
    {
        ts => start => finish => ts >= start && ts <= finish
    }

    export is_between_exclusive :: Int -> Int -> Int -> Bool
    {
        ts => start => finish => ts > start && ts < finish
    }
}
