Math :: module {
    import FloatMath



    math_fabs :: Float -> Float compiler(internal, intrinsic: "math_fabs");




    math_fmin :: Float -> Float -> Float compiler(internal, intrinsic: "math_fmin");




    math_fmax :: Float -> Float -> Float compiler(internal, intrinsic: "math_fmax");




    math_copysign :: Float -> Float -> Float compiler(internal, intrinsic: "math_copysign");




    math_pow :: Float -> Float -> Float compiler(internal, intrinsic: "math_pow");


    export abs :: Int -> Int
    {
        n => if n < 0 then { 0 - n } else { n }
    }

    export min :: Int -> Int -> Int
    {
        left => right => if left <= right then { left } else { right }
    }

    export max :: Int -> Int -> Int
    {
        left => right => if left >= right then { left } else { right }
    }

    export clamp :: Int -> Int -> Int -> Int
    {
        value => lower => upper =>
            if value < lower then { lower }
            else if value > upper then { upper }
            else { value }
    }

    export min3 :: Int -> Int -> Int -> Int
    {
        a => b => c => Math.min(Math.min(a)(b))(c)
    }

    export max3 :: Int -> Int -> Int -> Int
    {
        a => b => c => Math.max(Math.max(a)(b))(c)
    }

    export clamp01 :: Int -> Int
    {
        value => Math.clamp(value)(0)(1)
    }

    export sign :: Int -> Int
    {
        n when n < 0 => -1,
        n when n > 0 => 1,
        _ => 0
    }

    export is_zero :: Int -> Bool { n => n == 0 }

    export is_positive :: Int -> Bool { n => n > 0 }

    export is_negative :: Int -> Bool { n => n < 0 }

    export is_even :: Int -> Bool { n => n % 2 == 0 }

    export is_odd :: Int -> Bool { n => n % 2 != 0 }

    export between_inclusive :: Int -> Int -> Int -> Bool
    {
        value => lower => upper => value >= lower && value <= upper
    }

    export between_exclusive :: Int -> Int -> Int -> Bool
    {
        value => lower => upper => value > lower && value < upper
    }

    export distance :: Int -> Int -> Int
    {
        left => right => Math.abs(left - right)
    }

    export gcd :: Int -> Int -> Int
    {
        left => right => {
            a := abs(left);
            b := abs(right);
            if b == 0 then { a } else { gcd(b)(a % b) }
        }
    }

    export lcm :: Int -> Int -> Int
    {
        left => right => if left == 0 || right == 0 then { 0 } else { abs((left / gcd(left)(right)) * right) }
    }

    export pow :: Int -> Int -> Int
    {
        base => exp =>
            if exp < 0 then { 0 }
            else if exp == 0 then { 1 }
            else { base * pow(base)(exp - 1) }
    }

    export square :: Int -> Int
    {
        value => value * value
    }

    export cube :: Int -> Int
    {
        value => value * value * value
    }

    export div_floor :: Int -> Int -> Int
    {
        dividend => divisor =>
            if divisor == 0 then { 0 }
            else {
                q := dividend / divisor;
                r := dividend % divisor;
                if r != 0 && ((r < 0 && divisor > 0) || (r > 0 && divisor < 0))
                then { q - 1 }
                else { q }
            }
    }

    export div_ceil :: Int -> Int -> Int
    {
        dividend => divisor =>
            if divisor == 0 then { 0 }
            else { 0 - Math.div_floor(0 - dividend)(divisor) }
    }

    export mod_floor :: Int -> Int -> Int
    {
        dividend => divisor =>
            if divisor == 0 then { 0 }
            else { dividend - Math.div_floor(dividend)(divisor) * divisor }
    }

    export wrap :: Int -> Int -> Int
    {
        value => modulus =>
            if modulus <= 0 then { 0 }
            else { Math.mod_floor(value)(modulus) }
    }

    export wrap_range :: Int -> Int -> Int -> Int
    {
        value => lower => upper => {
            span := upper - lower;
            if span <= 0 then { lower }
            else { lower + Math.wrap(value - lower)(span) }
        }
    }

    export average_floor :: Int -> Int -> Int
    {
        left => right => Math.div_floor(left + right)(2)
    }

    export average_ceil :: Int -> Int -> Int
    {
        left => right => Math.div_ceil(left + right)(2)
    }

    export align_down :: Int -> Int -> Int
    {
        value => alignment =>
            if alignment <= 0 then { value }
            else { value - Math.wrap(value)(alignment) }
    }

    export align_up :: Int -> Int -> Int
    {
        value => alignment =>
            if alignment <= 0 then { value }
            else { Math.align_down(value + alignment - 1)(alignment) }
    }

    export approach :: Int -> Int -> Int -> Int
    {
        current => target => delta =>
            if delta <= 0 then { current }
            else if current < target then { Math.min(current + delta)(target) }
            else { Math.max(current - delta)(target) }
    }

    export factorial :: Int -> Int
    {
        n =>
            if n < 0 then { 0 }
            else if n == 0 then { 1 }
            else { n * Math.factorial(n - 1) }
    }

    // Float 版本
    export abs :: Float -> Float need ffi { x => math_fabs(x) }
    export min :: Float -> Float -> Float need ffi { left => right => math_fmin(left)(right) }
    export max :: Float -> Float -> Float need ffi { left => right => math_fmax(left)(right) }
    export clamp :: Float -> Float -> Float -> Float
    {
        value => lower => upper =>
            if value < lower then { lower }
            else if value > upper then { upper }
            else { value }
    }
    export sign :: Float -> Float need ffi { x => math_copysign(1.0)(x) }
    export pow :: Float -> Float -> Float need ffi { base => exp => math_pow(base)(exp) }
    export is_zero :: Float -> Bool { x => FloatMath.is_zero(x) }
    export is_positive :: Float -> Bool { x => FloatMath.is_positive(x) }
    export is_negative :: Float -> Bool { x => FloatMath.is_negative(x) }
    export between_inclusive :: Float -> Float -> Float -> Bool { value => lower => upper => FloatMath.between_inclusive(value)(lower)(upper) }
    export between_exclusive :: Float -> Float -> Float -> Bool { value => lower => upper => FloatMath.between_exclusive(value)(lower)(upper) }
    export square :: Float -> Float { value => FloatMath.square(value) }
    export cube :: Float -> Float { value => FloatMath.cube(value) }
    export approx_eq :: Float -> Float -> Float -> Bool need ffi { left => right => tolerance => FloatMath.approx_eq(left)(right)(tolerance) }
    export distance :: Float -> Float -> Float need ffi { left => right => FloatMath.distance(left)(right) }
    export hypot :: Float -> Float -> Float need ffi { left => right => FloatMath.hypot(left)(right) }
    export degrees_to_radians :: Float -> Float { degrees => FloatMath.degrees_to_radians(degrees) }
    export radians_to_degrees :: Float -> Float { radians => FloatMath.radians_to_degrees(radians) }
    export lerp :: Float -> Float -> Float -> Float { start => end => t => FloatMath.lerp(start)(end)(t) }
    export inverse_lerp :: Float -> Float -> Float -> Float { start => end => value => FloatMath.inverse_lerp(start)(end)(value) }

}
