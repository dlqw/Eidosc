Option :: module {
    import Display
    import Traits
    import Ordering.{Ordering}
    import Ordering
    import TraitInvoke
    import Functor
    import Applicative
    import Foldable
    import Monad
    import Traversable
    import Semigroup

    export Option[T] :: type { Some:: type(T) , None :: type {} }

    export CloneOptionT :: instance Traits.Clone {
        clone[T: Traits.Clone] :: Ref[Option[T]] -> Option[T]
            {
                value => match *value {
                    Some(item) => Some(TraitInvoke.clone_value(ref item)),
                    None() => None()
                }
            }
    }


    identity[T] :: T -> T
     compiler(internal)
{
        value => value
    }


    compose[A, B, C, E1: effects, E2: effects] :: (B -> C need E1) -> (A -> B need E2) -> A -> C need E1, E2
     compiler(internal)
{
        g, f, value => g(f(value))
    }


    apply_to[A, B, E: effects] :: A -> (A -> B need E) -> B need E
     compiler(internal)
{
        value, f => f(value)
    }


    bind_then[A, B, C, E1: effects, E2: effects] :: (A -> Option[B] need E1) -> (B -> Option[C] need E2) -> A -> Option[C] need E1, E2
     compiler(internal)
{
        f, g, value => f(value).bind(g)
    }


    some_wrap[T] :: T -> Option[T]
     compiler(internal)
{
        value => Some(value)
    }

    export is_some[T] :: Option[T] -> Bool
    {
        Some(_) => true,
        None() => false
    }

    export is_none[T] :: Option[T] -> Bool
    {
        Some(_) => false,
        None() => true
    }

    export map[T, U, E: effects] :: Option[T] -> (T -> U need E) -> Option[U] need E
    {
        Some(value) => f => Some(f(value)),
        None() => _ => None()
    }

    export and_then[T, U, E: effects] :: Option[T] -> (T -> Option[U] need E) -> Option[U] need E
    {
        Some(value) => f => f(value),
        None() => _ => None()
    }

    export and[T, U] :: Option[T] -> Option[U] -> Option[U]
    {
        Some(_) => other => other,
        None() => _ => None()
    }

    export or[T] :: Option[T] -> Option[T] -> Option[T]
    {
        Some(value) => _ => Some(value),
        None() => other => other
    }

    export xor[T] :: Option[T] -> Option[T] -> Option[T]
    {
        Some(left_value), Some(right_value) => None(),
        Some(left_value), None()            => Some(left_value),
        None(), Some(right_value)            => Some(right_value),
        None(), None()                       => None()
    }

    export map_or[T, U, E: effects] :: Option[T] -> U -> (T -> U need E) -> U need E
    {
        Some(value) => _ => f => f(value),
        None() => fallback => _ => fallback
    }

    export map_or_else[T, U, E1: effects, E2: effects] :: Option[T] -> (Unit -> U need E1) -> (T -> U need E2) -> U need E1, E2
    {
        Some(value) => _ => f => f(value),
        None() => fallback => _ => fallback(())
    }

    export unwrap_or[T] :: Option[T] -> T -> T compiler(role: "operator.coalesce")
    {
        Some(value) => _ => value,
        None() => fallback => fallback
    }

    export unwrap_or_else[T, E: effects] :: Option[T] -> (Unit -> T need E) -> T need E
    {
        Some(value) => _ => value,
        None() => fallback => fallback(())
    }

    export contains[T: Traits.Eq] :: Option[T] -> T -> Bool
    {
        Some(value) => expected => TraitInvoke.eq_value(value)(expected),
        None() => _ => false
    }

    export filter[T: Traits.Clone, E: effects] :: Option[T] -> (T -> Bool need E) -> Option[T] need E
    {
        Some(value) => predicate => {
            candidate := TraitInvoke.clone_value(ref value);
            if predicate(candidate) then { Some(value) } else { None() }
        },
        None() => _ => None()
    }

    export zip[A, B] :: Option[A] -> Option[B] -> Option[(A, B)]
    {
        Some(left_value), Some(right_value) => Some((left_value, right_value)),
        Some(left_value), None()            => None(),
        None(), Some(right_value)            => None(),
        None(), None()                       => None()
    }

    export zip_with[A, B, C, E: effects] :: Option[A] -> Option[B] -> (A -> B -> C need E) -> Option[C] need E
    {
        Some(left_value), Some(right_value), f => Some(f(left_value)(right_value)),
        Some(left_value), None(), _            => None(),
        None(), Some(right_value), _            => None(),
        None(), None(), _                       => None(),
        _, _, _                                 => None()
    }

    export flatten[T] :: Option[Option[T]] -> Option[T]
    {
        Some(inner) => inner,
        None() => None()
    }

    export FoldableOption :: instance Foldable.Foldable[Option] {
        fold_left[A, B, E: effects] :: Option[A] -> B -> (B -> A -> B need E) -> B need E
            {
                Some(value) => acc => f => f(acc)(value),
                None() => acc => _ => acc
            }
        fold_right[A, B, E: effects] :: Option[A] -> B -> (A -> B -> B need E) -> B need E
            {
                Some(value) => acc => f => f(value)(acc),
                None() => acc => _ => acc
            }
    }

    export TraversableOption :: instance Traversable.Traversable[Option] {
        traverse[A, B, G: kind2 : Applicative.Applicative[G], E: effects] :: Option[A] -> (A -> G[B] need E) -> G[Option[B]] need E
            {
                Some(value) => f => Traversable.map_applicative(Option.some_wrap)(f(value)),
                None() => _ => Traversable.lift_pure(None())
            }
    }

    export sequence[A, G: kind2 : Applicative.Applicative[G]] :: Option[G[A]] -> G[Option[A]]
    {
        option => Traversable.traverse(option)(Traversable.identity_applicative)
    }

    export EqOptionT :: instance Traits.Eq {
        eq[T: Traits.Eq] :: Option[T] -> Option[T] -> Bool
            {
                Some(left_value), Some(right_value) => TraitInvoke.eq_value(left_value)(right_value),
                Some(left_value), None()            => false,
                None(), Some(right_value)            => false,
                None(), None()                       => true
            }
    }

    export OrdOptionT :: instance Traits.Ord {
        compare[T: Traits.Ord] :: Option[T] -> Option[T] -> Ordering
            {
                Some(left_value), Some(right_value) => TraitInvoke.compare_value(left_value)(right_value),
                Some(left_value), None()            => Greater(),
                None(), Some(right_value)            => Less(),
                None(), None()                       => Equal()
            }
    }

    export ShowOptionT :: instance Traits.Show {
        show[T: Traits.Show] :: Option[T] -> String
            {
                Some(value) => "Some(" ++ TraitInvoke.show_value(value) ++ ")",
                None() => "None"
            }
    }

    export FunctorOption :: instance Functor.Functor[Option] {
        fmap[A, B, E: effects] :: Option[A] -> (A -> B need E) -> Option[B] need E
            {
                option => f => Option.map(option)(f)
            }
    }

    export ApplicativeOption :: instance Applicative.Applicative[Option] {
        pure[A] :: A -> Option[A]
            {
                value => Some(value)
            }
        apply[A, B, E: effects] :: Option[A -> B need E] -> Option[A] -> Option[B] need E
            {
                Some(f) => Some(value) => Some(f(value)),
                Some(_) => None() => None(),
                None() => _ => None()
            }
    }

    export MonadOption :: instance Monad.Monad[Option] {
        pure[A] :: A -> Option[A]
            {
                value => Some(value)
            }
        bind[A, B, E: effects] :: Option[A] -> (A -> Option[B] need E) -> Option[B] need E
            {
                option => f => Option.and_then(option)(f)
            }
    }

    export DisplayOption :: instance Display {
        display[T: Display] :: Ref[Option[T]] -> String
            {
                value => match *value {
                    Some(inner) => "Some(" ++ Display.render(ref inner) ++ ")",
                    None() => "None"
                }
            }
    }


    export append[T: Semigroup.Semigroup] :: Option[T] -> Option[T] -> Option[T]
    {
        Some(left) => Some(right) => Some(Semigroup.append(left)(right)),
        Some(value) => None() => Some(value),
        None() => Some(value) => Some(value),
        None() => None() => None()
    }

    export empty[A] :: Unit -> Option[A]
    {
        _ => None()
    }

    export or_else[A] :: Option[A] -> Option[A] -> Option[A]
    {
        Some(value) => _ => Some(value),
        None() => fallback => fallback
    }

    export or_else_with[A, E: effects] :: Option[A] -> (Unit -> Option[A] need E) -> Option[A] need E
    {
        Some(value) => _ => Some(value),
        None() => fallback => fallback(())
    }

    // ── Additional functions ──────────────────────────────────────

    export to_seq[T] :: Option[T] -> Seq[T]
    {
        Some(value) => [value],
        None() => []
    }

    export map2[A, B, C, E: effects] :: Option[A] -> Option[B] -> (A -> B -> C need E) -> Option[C] need E
    {
        Some(a) => Some(b) => f => Some(f(a)(b)),
        _ => _ => _ => None()
    }
}
