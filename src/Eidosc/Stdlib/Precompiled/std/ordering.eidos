Ordering :: module {
    import Display
    import Traits
    import Semigroup

    export Ordering :: type { Less :: type {} , Equal :: type {} , Greater :: type {} }

    export is_lt :: Ordering -> Bool
    {
        Less() => true,
        Equal() => false,
        Greater() => false
    }

    export is_eq :: Ordering -> Bool
    {
        Less() => false,
        Equal() => true,
        Greater() => false
    }

    export is_gt :: Ordering -> Bool
    {
        Less() => false,
        Equal() => false,
        Greater() => true
    }

    export is_le :: Ordering -> Bool
    {
        Less() => true,
        Equal() => true,
        Greater() => false
    }

    export is_ge :: Ordering -> Bool
    {
        Less() => false,
        Equal() => true,
        Greater() => true
    }

    export is_ne :: Ordering -> Bool
    {
        ordering => !Ordering.is_eq(ordering)
    }

    export to_int :: Ordering -> Int
    {
        Less() => -1,
        Equal() => 0,
        Greater() => 1
    }

    export from_int :: Int -> Ordering
    {
        value =>
            if value < 0 then { Less() }
            else if value > 0 then { Greater() }
            else { Equal() }
    }

    export fold[A] :: Ordering -> A -> A -> A -> A
    {
        Less() => less_value => _ => _ => less_value,
        Equal() => _ => equal_value => _ => equal_value,
        Greater() => _ => _ => greater_value => greater_value
    }

    export select_le[A] :: Ordering -> A -> A -> A
    {
        Less() => left => _ => left,
        Equal() => left => _ => left,
        Greater() => _ => right => right
    }

    export select_ge[A] :: Ordering -> A -> A -> A
    {
        Less() => _ => right => right,
        Equal() => left => _ => left,
        Greater() => left => _ => left
    }

    export reverse :: Ordering -> Ordering
    {
        Less() => Greater(),
        Equal() => Equal(),
        Greater() => Less()
    }

    export then_with :: Ordering -> Ordering -> Ordering
    {
        Less() => _ => Less(),
        Equal() => next => next,
        Greater() => _ => Greater()
    }

    export then_compare :: Ordering -> Int -> Int -> Ordering
    {
        ordering => left => right => Ordering.then_with(ordering)(Ordering.compare(left)(right))
    }

    export then_compare :: Ordering -> Char -> Char -> Ordering
    {
        ordering => left => right => Ordering.then_with(ordering)(Ordering.compare(left)(right))
    }

    export then_compare :: Ordering -> Bool -> Bool -> Ordering
    {
        ordering => left => right => Ordering.then_with(ordering)(Ordering.compare(left)(right))
    }

    export then_compare :: Ordering -> Ordering -> Ordering -> Ordering
    {
        ordering => left => right => Ordering.then_with(ordering)(Ordering.compare(left)(right))
    }

    export compare :: Ordering -> Ordering -> Ordering
    {
        Less(), Less()       => Equal(),
        Less(), _            => Less(),
        Equal(), Less()      => Greater(),
        Equal(), Equal()     => Equal(),
        Equal(), Greater()   => Less(),
        Greater(), Greater() => Equal(),
        Greater(), _         => Greater()
    }

    export compare :: Int -> Int -> Ordering
    {
        left, right when left < right => Less(),
        left, right when left > right => Greater(),
        _, _                          => Equal()
    }

    export compare :: Char -> Char -> Ordering
    {
        left, right when left < right => Less(),
        left, right when left > right => Greater(),
        _, _                          => Equal()
    }

    export compare :: Bool -> Bool -> Ordering
    {
        left => right =>
            if left == right then { Equal() }
            else if left then { Greater() }
            else { Less() }
    }

    export compare_desc :: Int -> Int -> Ordering
    {
        left => right => Ordering.reverse(Ordering.compare(left)(right))
    }

    export compare_desc :: Char -> Char -> Ordering
    {
        left => right => Ordering.reverse(Ordering.compare(left)(right))
    }

    export compare_desc :: Bool -> Bool -> Ordering
    {
        left => right => Ordering.reverse(Ordering.compare(left)(right))
    }

    export EqOrdering :: instance Traits.Eq {
        eq :: Ordering -> Ordering -> Bool
            {
                Less(), Less()       => true,
                Equal(), Equal()     => true,
                Greater(), Greater() => true,
                _, _                 => false
            }
    }

    export EqBool :: instance Traits.Eq {
        eq :: Bool -> Bool -> Bool
            {
                left => right => left == right
            }
    }

    export OrdOrdering :: instance Traits.Ord {
        compare :: Ordering -> Ordering -> Ordering
            {
                left => right => Ordering.compare(left)(right)
            }
    }

    export OrdBool :: instance Traits.Ord {
        compare :: Bool -> Bool -> Ordering
            {
                false => false => Equal(),
                false => true => Less(),
                true => false => Greater(),
                true => true => Equal()
            }
    }

    export ShowOrdering :: instance Traits.Show {
        show :: Ordering -> String
            {
                Less() => "Less",
                Equal() => "Equal",
                Greater() => "Greater"
            }
    }

    export DisplayOrdering :: instance Display {
        display :: Ref[Ordering] -> String
            {
                value => match *value {
                    Less() => "Less",
                    Equal() => "Equal",
                    Greater() => "Greater"
                }
            }
    }

    export ShowBool :: instance Traits.Show {
        show :: Bool -> String
            {
                true => "true",
                false => "false"
            }
    }

    export SemigroupOrdering :: instance Semigroup.Semigroup {
        append :: Ordering -> Ordering -> Ordering
            {
                left => right => Ordering.then_with(left)(right)
            }
    }

    export CloneOrdering :: instance Traits.Clone {
        clone :: Ref[Ordering] -> Ordering
            {
                value => match *value {
                    Less() => Less(),
                    Equal() => Equal(),
                    Greater() => Greater()
                }
            }
    }

    export CloneBool :: instance Traits.Clone {
        clone :: Ref[Bool] -> Bool
            {
                value => *value
            }
    }
}
