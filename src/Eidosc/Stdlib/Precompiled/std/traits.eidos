Traits :: module {
    import Ordering.{Ordering}

    export Eq :: trait {
        eq :: Self -> Self -> Bool compiler(role: "trait.equality")
    }

    export Ord :: trait {
        compare :: Self -> Self -> Ordering
    }

    export Show :: trait {
        show :: Self -> String compiler(role: "trait.show")
    }

    export Hash :: trait {
        hash :: Self -> Int
    }

    export Clone :: trait {
        clone :: Ref[Self] -> Self
    }

    export Copy :: trait {
    }
}
