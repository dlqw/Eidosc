Applicative :: module {

    export Applicative[F: kind2] :: trait {
        pure[A] :: A -> F[A]
        apply[A, B, E: effects] :: F[A -> B need E] -> F[A] -> F[B] need E compiler(role: "operator.apply")
    }

    export lift[A, F: kind2 : Applicative[F]] :: A -> F[A]
    {
        value => value |> Applicative.pure
    }

    export map[A, B, F: kind2 : Applicative[F], E: effects] :: F[A] -> (A -> B need E) -> F[B] need E
    {
        values, f => Applicative.apply(Applicative.pure(f), values)
    }

    export ap[A, B, F: kind2 : Applicative[F], E: effects] :: F[A -> B need E] -> F[A] -> F[B] need E
    {
        functions, values => Applicative.apply(functions, values)
    }

    export map2[A, B, C, F: kind2 : Applicative[F], E: effects] :: F[A] -> F[B] -> (A -> B -> C need E) -> F[C] need E
    {
        left, right, f => Applicative.apply(Applicative.map(left, f), right)
    }

    export lift2[A, B, C, F: kind2 : Applicative[F], E: effects] :: (A -> B -> C need E) -> F[A] -> F[B] -> F[C] need E
    {
        f, left, right => Applicative.map2(left, right, f)
    }

    export product[A, B, F: kind2 : Applicative[F]] :: F[A] -> F[B] -> F[(A, B)]
    {
        left, right => Applicative.map2(left, right, a => b => (a, b))
    }

    export void[A, F: kind2 : Applicative[F]] :: F[A] -> F[Unit]
    {
        values => Applicative.map(values, _ => ())
    }
}
