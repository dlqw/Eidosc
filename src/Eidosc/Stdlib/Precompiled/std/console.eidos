Console :: module {
    import Display
    import Option
    import Result

    write_char_code_raw :: Int -> Unit compiler(internal, intrinsic: "write_char_code_raw") need io;
    read_line_raw :: Unit -> String compiler(internal, intrinsic: "read_line") need io;
    read_char :: Unit -> Int compiler(internal, intrinsic: "read_char") need io;
    terminal_set_raw :: Unit -> Unit compiler(internal, intrinsic: "terminal_set_raw") need io;
    terminal_restore :: Unit -> Unit compiler(internal, intrinsic: "terminal_restore") need io;
    sleep_ms :: Int -> Unit compiler(internal, intrinsic: "sleep_ms") need io;
    io_last_success :: Unit -> Bool compiler(internal, intrinsic: "io_last_success") need io;
    io_last_error :: Unit -> String compiler(internal, intrinsic: "io_last_error") need io;


    export write[T: Display] :: Ref[T] -> Unit need io
    {
        value => print(value)
    }

    export write[T: Display] :: String -> Ref[T] -> Unit need io
    {
        prefix => value => {
            print(prefix);
            print(value)
        }
    }

    export write_line[T: Display] :: Ref[T] -> Unit need io
    {
        value => println(value)
    }

    export write_line[T: Display] :: String -> Ref[T] -> Unit need io
    {
        prefix => value => {
            print(prefix);
            println(value)
        }
    }

    export write_line :: Unit -> Unit need io
    {
        _ => println()
    }

    export write_char_code :: Int -> Unit need io
    {
        code => write_char_code_raw(code)
    }

    export write_char_code :: String -> Int -> Unit need io
    {
        prefix => code => {
            print(prefix);
            write_char_code_raw(code)
        }
    }

    export write_char_code_line :: Int -> Unit need io
    {
        code => {
            write_char_code_raw(code);
            println()
        }
    }

    export write_char_code_line :: String -> Int -> Unit need io
    {
        prefix => code => {
            print(prefix);
            write_char_code_raw(code);
            println()
        }
    }

    export read_char_code :: Unit -> Int need io
    {
        _ => read_char()
    }

    export set_raw_mode :: Unit -> Unit need io
    {
        _ => terminal_set_raw()
    }

    export restore_terminal :: Unit -> Unit need io
    {
        _ => terminal_restore()
    }

    export sleep_milliseconds :: Int -> Unit need io
    {
        milliseconds => sleep_ms(milliseconds)
    }

    export read_line :: Unit -> String need io
    {
        _ => read_line_raw()
    }

    export read_line_result :: Unit -> Result[String, String] need io
    {
        _ => {
            text := read_line_raw();
            if io_last_success() then { Ok(text) } else { Err(io_last_error()) }
        }
    }

    export read_line_opt :: Unit -> Option[String] need io
    {
        _ => {
            text := read_line_raw();
            if io_last_success() then { Some(text) } else { None() }
        }
    }

    export read_line_or_empty :: Unit -> String need io
    {
        _ => Console.read_line_or("")
    }

    export read_line_or :: String -> String need io
    {
        fallback => {
            text := read_line_raw();
            if io_last_success() then { text } else { fallback }
        }
    }

    export read_line_or_else[E: effects] :: (Unit -> String need E) -> String need io, E
    {
        fallback => {
            text := read_line_raw();
            if io_last_success() then { text } else { fallback(()) }
        }
    }
}
