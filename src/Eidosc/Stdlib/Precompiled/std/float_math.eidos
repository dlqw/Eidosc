FloatMath :: module {


    math_sin :: Float -> Float compiler(internal, intrinsic: "math_sin");




    math_cos :: Float -> Float compiler(internal, intrinsic: "math_cos");




    math_tan :: Float -> Float compiler(internal, intrinsic: "math_tan");




    math_asin :: Float -> Float compiler(internal, intrinsic: "math_asin");




    math_acos :: Float -> Float compiler(internal, intrinsic: "math_acos");




    math_atan :: Float -> Float compiler(internal, intrinsic: "math_atan");




    math_atan2 :: Float -> Float -> Float compiler(internal, intrinsic: "math_atan2");




    math_sqrt :: Float -> Float compiler(internal, intrinsic: "math_sqrt");




    math_exp :: Float -> Float compiler(internal, intrinsic: "math_exp");




    math_log :: Float -> Float compiler(internal, intrinsic: "math_log");




    math_log2 :: Float -> Float compiler(internal, intrinsic: "math_log2");




    math_log10 :: Float -> Float compiler(internal, intrinsic: "math_log10");




    math_pow :: Float -> Float -> Float compiler(internal, intrinsic: "math_pow");




    math_fabs :: Float -> Float compiler(internal, intrinsic: "math_fabs");




    math_ceil :: Float -> Float compiler(internal, intrinsic: "math_ceil");




    math_floor :: Float -> Float compiler(internal, intrinsic: "math_floor");




    math_round :: Float -> Float compiler(internal, intrinsic: "math_round");




    math_trunc :: Float -> Float compiler(internal, intrinsic: "math_trunc");




    math_fma :: Float -> Float -> Float -> Float compiler(internal, intrinsic: "math_fma");




    math_copysign :: Float -> Float -> Float compiler(internal, intrinsic: "math_copysign");




    math_fmin :: Float -> Float -> Float compiler(internal, intrinsic: "math_fmin");




    math_fmax :: Float -> Float -> Float compiler(internal, intrinsic: "math_fmax");


    // 三角函数
    export sin :: Float -> Float need ffi { x => math_sin(x) }
    export cos :: Float -> Float need ffi { x => math_cos(x) }
    export tan :: Float -> Float need ffi { x => math_tan(x) }

    // 反三角函数
    export asin :: Float -> Float need ffi { x => math_asin(x) }
    export acos :: Float -> Float need ffi { x => math_acos(x) }
    export atan :: Float -> Float need ffi { x => math_atan(x) }
    export atan2 :: Float -> Float -> Float need ffi { y => x => math_atan2(y)(x) }

    // 幂/指数/对数
    export sqrt :: Float -> Float need ffi { x => math_sqrt(x) }
    export exp :: Float -> Float need ffi { x => math_exp(x) }
    export log :: Float -> Float need ffi { x => math_log(x) }
    export log2 :: Float -> Float need ffi { x => math_log2(x) }
    export log10 :: Float -> Float need ffi { x => math_log10(x) }
    export pow :: Float -> Float -> Float need ffi { base => e => math_pow(base)(e) }

    // 取整
    export abs :: Float -> Float need ffi { x => math_fabs(x) }
    export fabs :: Float -> Float need ffi { x => math_fabs(x) }
    export ceil :: Float -> Float need ffi { x => math_ceil(x) }
    export floor :: Float -> Float need ffi { x => math_floor(x) }
    export round :: Float -> Float need ffi { x => math_round(x) }
    export trunc :: Float -> Float need ffi { x => math_trunc(x) }

    // 其他
    export fma :: Float -> Float -> Float -> Float need ffi { a => b => c => math_fma(a)(b)(c) }
    export copysign :: Float -> Float -> Float need ffi { mag => sgn => math_copysign(mag)(sgn) }
    export fmin :: Float -> Float -> Float need ffi { a => b => math_fmin(a)(b) }
    export fmax :: Float -> Float -> Float need ffi { a => b => math_fmax(a)(b) }

    export is_zero :: Float -> Bool { x => x == 0.0 }

    export is_positive :: Float -> Bool { x => x > 0.0 }

    export is_negative :: Float -> Bool { x => x < 0.0 }

    export sign :: Float -> Int
    {
        x =>
            if x < 0.0 then { -1 }
            else if x > 0.0 then { 1 }
            else { 0 }
    }

    export between_inclusive :: Float -> Float -> Float -> Bool
    {
        value => lower => upper => value >= lower && value <= upper
    }

    export between_exclusive :: Float -> Float -> Float -> Bool
    {
        value => lower => upper => value > lower && value < upper
    }

    export clamp :: Float -> Float -> Float -> Float
    {
        value => lower => upper =>
            if value < lower then { lower }
            else if value > upper then { upper }
            else { value }
    }

    export min3 :: Float -> Float -> Float -> Float need ffi
    {
        a => b => c => FloatMath.fmin(FloatMath.fmin(a)(b))(c)
    }

    export max3 :: Float -> Float -> Float -> Float need ffi
    {
        a => b => c => FloatMath.fmax(FloatMath.fmax(a)(b))(c)
    }

    export saturate :: Float -> Float
    {
        value => FloatMath.clamp(value)(0.0)(1.0)
    }

    export square :: Float -> Float
    {
        value => value * value
    }

    export cube :: Float -> Float
    {
        value => value * value * value
    }

    export fract :: Float -> Float need ffi
    {
        value => value - FloatMath.floor(value)
    }

    export approx_eq :: Float -> Float -> Float -> Bool need ffi
    {
        left => right => tolerance => FloatMath.abs(left - right) <= FloatMath.abs(tolerance)
    }

    export distance :: Float -> Float -> Float need ffi
    {
        left => right => FloatMath.abs(left - right)
    }

    export hypot :: Float -> Float -> Float need ffi
    {
        x => y => FloatMath.sqrt(FloatMath.square(x) + FloatMath.square(y))
    }

    export degrees_to_radians :: Float -> Float
    {
        degrees => degrees * pi / 180.0
    }

    export radians_to_degrees :: Float -> Float
    {
        radians => radians * 180.0 / pi
    }

    export lerp :: Float -> Float -> Float -> Float
    {
        start => end => t => start + (end - start) * t
    }

    export inverse_lerp :: Float -> Float -> Float -> Float
    {
        start => end => value =>
            if start == end then { 0.0 }
            else { (value - start) / (end - start) }
    }

    export wrap :: Float -> Float -> Float -> Float need ffi
    {
        value => lower => upper => {
            start := FloatMath.fmin(lower)(upper);
            stop := FloatMath.fmax(lower)(upper);
            span := stop - start;
            if span == 0.0
            then { start }
            else { start + ((value - start) - FloatMath.floor((value - start) / span) * span) }
        }
    }

    export repeat :: Float -> Float -> Float need ffi
    {
        value => length =>
            if length <= 0.0 then { 0.0 }
            else { FloatMath.wrap(value)(0.0)(length) }
    }

    export ping_pong :: Float -> Float -> Float need ffi
    {
        value => length =>
            if length <= 0.0 then { 0.0 }
            else {
                doubled := length * 2.0;
                t := FloatMath.repeat(value)(doubled);
                if t <= length then { t } else { doubled - t }
            }
    }

    export step :: Float -> Float -> Float
    {
        edge => value => if value < edge then { 0.0 } else { 1.0 }
    }

    export smoothstep :: Float -> Float -> Float -> Float
    {
        edge0 => edge1 => value =>
            if edge0 == edge1 then { FloatMath.step(edge0)(value) }
            else {
                t := FloatMath.saturate((value - edge0) / (edge1 - edge0));
                t * t * (3.0 - 2.0 * t)
            }
    }

    export remap :: Float -> Float -> Float -> Float -> Float -> Float
    {
        in_min => in_max => out_min => out_max => value =>
            if in_min == in_max then { out_min }
            else { FloatMath.lerp(out_min)(out_max)(FloatMath.inverse_lerp(in_min)(in_max)(value)) }
    }

    export move_toward :: Float -> Float -> Float -> Float need ffi
    {
        current => target => max_delta => {
            delta := target - current;
            distance := FloatMath.abs(delta);
            if max_delta <= 0.0 then { current }
            else if distance <= max_delta then { target }
            else { current + FloatMath.copysign(max_delta)(delta) }
        }
    }

    export angle_wrap_radians :: Float -> Float need ffi
    {
        value => FloatMath.wrap(value + pi)(0.0)(tau) - pi
    }

    export angle_wrap_degrees :: Float -> Float need ffi
    {
        value => FloatMath.wrap(value + 180.0)(0.0)(360.0) - 180.0
    }

    export angle_delta_radians :: Float -> Float -> Float need ffi
    {
        current => target => FloatMath.angle_wrap_radians(target - current)
    }

    export angle_delta_degrees :: Float -> Float -> Float need ffi
    {
        current => target => FloatMath.angle_wrap_degrees(target - current)
    }

    // 常量
    export pi :: Float = 3.14159265358979323846;
    export e :: Float = 2.71828182845904523536;
    export tau :: Float = 6.28318530717958647692;
}
