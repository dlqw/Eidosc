Deque :: module {
    import Seq
    import Option
    import Traits
    import TraitInvoke

    export Deque[T] :: type {front:: Seq[T], back:: Seq[T]}

    export empty[T] :: Unit -> Deque[T]
    {
        _ => Deque{front: [], back: []}
    }

    export singleton[T] :: T -> Deque[T]
    {
        value => Deque{front: [value], back: []}
    }

    export from_seq[T] :: Seq[T] -> Deque[T]
    {
        values => Deque{front: values, back: []}
    }

    export len[T] :: Ref[Deque[T]] -> Int
    {
        deque => match *deque {
            Deque{front: f, back: b} => Seq.len(ref f) + Seq.len(ref b)
        }
    }

    export is_empty[T] :: Ref[Deque[T]] -> Bool
    {
        deque => Deque.len(deque) == 0
    }

    export push_front[T] :: Deque[T] -> T -> Deque[T]
    {
        Deque{front: f, back: b} => value => Deque{front: [value, ..f], back: b}
    }

    export push_back[T] :: Deque[T] -> T -> Deque[T]
    {
        Deque{front: f, back: b} => value => Deque{front: f, back: [value, ..b]}
    }


    normalize_front[T] :: Deque[T] -> Deque[T]
     compiler(internal)
{
        Deque{front: [], back: b} => Deque{front: Seq.reverse(b), back: []},
        deque => deque
    }


    normalize_back[T] :: Deque[T] -> Deque[T]
     compiler(internal)
{
        Deque{front: f, back: []} => Deque{front: [], back: Seq.reverse(f)},
        deque => deque
    }

    export front[T] :: Deque[T] -> Option[T]
    {
        deque => match Deque.normalize_front(deque) {
            Deque{front: [value, ..], back: _} => Some(value),
            _ => None()
        }
    }

    export back[T] :: Deque[T] -> Option[T]
    {
        deque => match Deque.normalize_back(deque) {
            Deque{front: _, back: [value, ..]} => Some(value),
            _ => None()
        }
    }

    export pop_front[T] :: Deque[T] -> Option[(T, Deque[T])]
    {
        deque => match Deque.normalize_front(deque) {
            Deque{front: [value, ..rest], back: b} => Some((value, Deque{front: rest, back: b})),
            _ => None()
        }
    }

    export pop_back[T] :: Deque[T] -> Option[(T, Deque[T])]
    {
        deque => match Deque.normalize_back(deque) {
            Deque{front: f, back: [value, ..rest]} => Some((value, Deque{front: f, back: rest})),
            _ => None()
        }
    }

    export to_seq[T] :: Deque[T] -> Seq[T]
    {
        Deque{front: f, back: b} => Seq.append(f)(Seq.reverse(b))
    }

    export get_opt[T] :: Deque[T] -> Int -> Option[T]
    {
        deque => index => Seq.get_opt(Deque.to_seq(deque))(index)
    }

    export get_or[T] :: Deque[T] -> Int -> T -> T
    {
        deque => index => fallback => Option.unwrap_or(Deque.get_opt(deque)(index))(fallback)
    }

    export CloneDequeT :: instance Traits.Clone {
        clone[T: Traits.Clone] :: Ref[Deque[T]] -> Deque[T]
            {
                value => match *value {
                    Deque{front: f, back: b} => Deque{
                        front: TraitInvoke.clone_value(ref f),
                        back: TraitInvoke.clone_value(ref b)
                    }
                }
            }
    }

    export EqDequeT :: instance Traits.Eq {
        eq[T: Traits.Eq] :: Deque[T] -> Deque[T] -> Bool
            {
                left => right => TraitInvoke.eq_value(Deque.to_seq(left))(Deque.to_seq(right))
            }
    }
}
