GameMath :: module {
    import FloatMath
    import Math
    import Traits

    @[derive(Copy)]
    export IVec2 :: type {x:: Int, y:: Int}
    @[derive(Copy)]
    export Vec2 :: type {x:: Float, y:: Float}
    @[derive(Copy)]
    export IRect :: type {x:: Int, y:: Int, width:: Int, height:: Int}
    @[derive(Copy)]
    export Rect :: type {x:: Float, y:: Float, width:: Float, height:: Float}

    export zero_i :: IVec2 = IVec2{x: 0, y: 0};
    export unit_x_i :: IVec2 = IVec2{x: 1, y: 0};
    export unit_y_i :: IVec2 = IVec2{x: 0, y: 1};
    export up_i :: IVec2 = IVec2{x: 0, y: -1};
    export down_i :: IVec2 = IVec2{x: 0, y: 1};
    export left_i :: IVec2 = IVec2{x: -1, y: 0};
    export east_i :: IVec2 = IVec2{x: 1, y: 0};

    export zero :: Vec2 = Vec2{x: 0.0, y: 0.0};
    export unit_x :: Vec2 = Vec2{x: 1.0, y: 0.0};
    export unit_y :: Vec2 = Vec2{x: 0.0, y: 1.0};

    export ivec2 :: Int -> Int -> IVec2
    {
        x => y => IVec2{x: x, y: y}
    }

    export vec2 :: Float -> Float -> Vec2
    {
        x => y => Vec2{x: x, y: y}
    }

    export irect :: Int -> Int -> Int -> Int -> IRect
    {
        x => y => width => height => IRect{x: x, y: y, width: width, height: height}
    }

    export rect :: Float -> Float -> Float -> Float -> Rect
    {
        x => y => width => height => Rect{x: x, y: y, width: width, height: height}
    }

    export add :: IVec2 -> IVec2 -> IVec2
    {
        left => right => IVec2{x: left.x + right.x, y: left.y + right.y}
    }

    export sub :: IVec2 -> IVec2 -> IVec2
    {
        left => right => IVec2{x: left.x - right.x, y: left.y - right.y}
    }

    export scale :: IVec2 -> Int -> IVec2
    {
        value => scalar => IVec2{x: value.x * scalar, y: value.y * scalar}
    }

    export neg :: IVec2 -> IVec2
    {
        value => IVec2{x: 0 - value.x, y: 0 - value.y}
    }

    export min :: IVec2 -> IVec2 -> IVec2
    {
        left => right => IVec2{x: Math.min(left.x)(right.x), y: Math.min(left.y)(right.y)}
    }

    export max :: IVec2 -> IVec2 -> IVec2
    {
        left => right => IVec2{x: Math.max(left.x)(right.x), y: Math.max(left.y)(right.y)}
    }

    export clamp :: IVec2 -> IVec2 -> IVec2 -> IVec2
    {
        value => lower => upper =>
            IVec2{
                x: Math.clamp(value.x)(lower.x)(upper.x),
                y: Math.clamp(value.y)(lower.y)(upper.y)
            }
    }

    export dot :: IVec2 -> IVec2 -> Int
    {
        left => right => left.x * right.x + left.y * right.y
    }

    export cross :: IVec2 -> IVec2 -> Int
    {
        left => right => left.x * right.y - left.y * right.x
    }

    export length_sq :: IVec2 -> Int
    {
        value => GameMath.dot(value)(value)
    }

    export manhattan_len :: IVec2 -> Int
    {
        value => Math.abs(value.x) + Math.abs(value.y)
    }

    export distance_sq :: IVec2 -> IVec2 -> Int
    {
        left => right => GameMath.length_sq(GameMath.sub(left)(right))
    }

    export manhattan_distance :: IVec2 -> IVec2 -> Int
    {
        left => right => GameMath.manhattan_len(GameMath.sub(left)(right))
    }

    export inside_bounds :: IVec2 -> Int -> Int -> Bool
    {
        point => width => height =>
            point.x >= 0 && point.x < width && point.y >= 0 && point.y < height
    }

    export wrap :: IVec2 -> Int -> Int -> IVec2
    {
        point => width => height =>
            IVec2{
                x: Math.wrap(point.x)(width),
                y: Math.wrap(point.y)(height)
            }
    }

    export to_index :: Int -> IVec2 -> Int
    {
        width => point => point.y * width + point.x
    }

    export from_index :: Int -> Int -> IVec2
    {
        width => index =>
            if width <= 0
            then { GameMath.zero_i }
            else { IVec2{x: Math.wrap(index)(width), y: index / width} }
    }

    export add :: Vec2 -> Vec2 -> Vec2
    {
        left => right => Vec2{x: left.x + right.x, y: left.y + right.y}
    }

    export sub :: Vec2 -> Vec2 -> Vec2
    {
        left => right => Vec2{x: left.x - right.x, y: left.y - right.y}
    }

    export scale :: Vec2 -> Float -> Vec2
    {
        value => scalar => Vec2{x: value.x * scalar, y: value.y * scalar}
    }

    export div :: Vec2 -> Float -> Vec2
    {
        value => scalar =>
            if scalar == 0.0
            then { GameMath.zero }
            else { Vec2{x: value.x / scalar, y: value.y / scalar} }
    }

    export neg :: Vec2 -> Vec2
    {
        value => Vec2{x: 0.0 - value.x, y: 0.0 - value.y}
    }

    export min :: Vec2 -> Vec2 -> Vec2
    {
        left => right =>
            Vec2{
                x: if left.x <= right.x then left.x else right.x,
                y: if left.y <= right.y then left.y else right.y
            }
    }

    export max :: Vec2 -> Vec2 -> Vec2
    {
        left => right =>
            Vec2{
                x: if left.x >= right.x then left.x else right.x,
                y: if left.y >= right.y then left.y else right.y
            }
    }

    export clamp :: Vec2 -> Vec2 -> Vec2 -> Vec2
    {
        value => lower => upper =>
            Vec2{
                x: FloatMath.clamp(value.x)(lower.x)(upper.x),
                y: FloatMath.clamp(value.y)(lower.y)(upper.y)
            }
    }

    export dot :: Vec2 -> Vec2 -> Float
    {
        left => right => left.x * right.x + left.y * right.y
    }

    export cross :: Vec2 -> Vec2 -> Float
    {
        left => right => left.x * right.y - left.y * right.x
    }

    export length_sq :: Vec2 -> Float
    {
        value => GameMath.dot(value)(value)
    }

    export length :: Vec2 -> Float need ffi
    {
        value => FloatMath.sqrt(GameMath.length_sq(value))
    }

    export distance_sq :: Vec2 -> Vec2 -> Float
    {
        left => right => GameMath.length_sq(GameMath.sub(left)(right))
    }

    export distance :: Vec2 -> Vec2 -> Float need ffi
    {
        left => right => GameMath.length(GameMath.sub(left)(right))
    }

    export normalize :: Vec2 -> Vec2 need ffi
    {
        value => {
            len := GameMath.length(value);
            if len == 0.0 then { GameMath.zero } else { GameMath.div(value)(len) }
        }
    }

    export normalize_or :: Vec2 -> Vec2 -> Vec2 need ffi
    {
        value => fallback =>
            if GameMath.length_sq(value) == 0.0 then { fallback } else { GameMath.normalize(value) }
    }

    export lerp :: Vec2 -> Vec2 -> Float -> Vec2
    {
        start => end => t =>
            Vec2{
                x: FloatMath.lerp(start.x)(end.x)(t),
                y: FloatMath.lerp(start.y)(end.y)(t)
            }
    }

    export move_toward :: Vec2 -> Vec2 -> Float -> Vec2 need ffi
    {
        current => target => max_delta => {
            delta := GameMath.sub(target)(current);
            distance := GameMath.length(delta);
            if max_delta <= 0.0 || distance == 0.0 then { current }
            else if distance <= max_delta then { target }
            else { GameMath.add(current)(GameMath.scale(GameMath.div(delta)(distance))(max_delta)) }
        }
    }

    export from_angle_radians :: Float -> Vec2 need ffi
    {
        radians => Vec2{x: FloatMath.cos(radians), y: FloatMath.sin(radians)}
    }

    export from_angle_degrees :: Float -> Vec2 need ffi
    {
        degrees => GameMath.from_angle_radians(FloatMath.degrees_to_radians(degrees))
    }

    export angle_radians :: Vec2 -> Float need ffi
    {
        value => FloatMath.atan2(value.y)(value.x)
    }

    export angle_degrees :: Vec2 -> Float need ffi
    {
        value => FloatMath.radians_to_degrees(GameMath.angle_radians(value))
    }

    export rotate_radians :: Vec2 -> Float -> Vec2 need ffi
    {
        value => radians => {
            c := FloatMath.cos(radians);
            s := FloatMath.sin(radians);
            Vec2{x: value.x * c - value.y * s, y: value.x * s + value.y * c}
        }
    }

    export rotate_degrees :: Vec2 -> Float -> Vec2 need ffi
    {
        value => degrees => GameMath.rotate_radians(value)(FloatMath.degrees_to_radians(degrees))
    }

    export perpendicular :: Vec2 -> Vec2
    {
        value => Vec2{x: 0.0 - value.y, y: value.x}
    }

    export reflect :: Vec2 -> Vec2 -> Vec2
    {
        direction => normal => {
            scale_factor := 2.0 * GameMath.dot(direction)(normal);
            GameMath.sub(direction)(GameMath.scale(normal)(scale_factor))
        }
    }

    export floor :: Vec2 -> Vec2 need ffi
    {
        value => Vec2{x: FloatMath.floor(value.x), y: FloatMath.floor(value.y)}
    }

    export ceil :: Vec2 -> Vec2 need ffi
    {
        value => Vec2{x: FloatMath.ceil(value.x), y: FloatMath.ceil(value.y)}
    }

    export round :: Vec2 -> Vec2 need ffi
    {
        value => Vec2{x: FloatMath.round(value.x), y: FloatMath.round(value.y)}
    }

    export trunc :: Vec2 -> Vec2 need ffi
    {
        value => Vec2{x: FloatMath.trunc(value.x), y: FloatMath.trunc(value.y)}
    }

    export fract :: Vec2 -> Vec2 need ffi
    {
        value => Vec2{x: FloatMath.fract(value.x), y: FloatMath.fract(value.y)}
    }

    export approx_eq :: Vec2 -> Vec2 -> Float -> Bool need ffi
    {
        left => right => tolerance =>
            FloatMath.approx_eq(left.x)(right.x)(tolerance) &&
            FloatMath.approx_eq(left.y)(right.y)(tolerance)
    }

    export origin :: IRect -> IVec2
    {
        rect => IVec2{x: rect.x, y: rect.y}
    }

    export size :: IRect -> IVec2
    {
        rect => IVec2{x: rect.width, y: rect.height}
    }

    export right :: IRect -> Int
    {
        rect => rect.x + rect.width
    }

    export bottom :: IRect -> Int
    {
        rect => rect.y + rect.height
    }

    export contains_point :: IRect -> IVec2 -> Bool
    {
        rect => point =>
            point.x >= rect.x &&
            point.x < GameMath.right(rect) &&
            point.y >= rect.y &&
            point.y < GameMath.bottom(rect)
    }

    export intersects :: IRect -> IRect -> Bool
    {
        left => right =>
            left.x < GameMath.right(right) &&
            right.x < GameMath.right(left) &&
            left.y < GameMath.bottom(right) &&
            right.y < GameMath.bottom(left)
    }

    export translate_rect :: IRect -> IVec2 -> IRect
    {
        rect => delta => IRect{x: rect.x + delta.x, y: rect.y + delta.y, width: rect.width, height: rect.height}
    }

    export inflate :: IRect -> Int -> Int -> IRect
    {
        rect => dx => dy =>
            IRect{
                x: rect.x - dx,
                y: rect.y - dy,
                width: rect.width + dx * 2,
                height: rect.height + dy * 2
            }
    }

    export deflate :: IRect -> Int -> Int -> IRect
    {
        rect => dx => dy =>
            IRect{
                x: rect.x + dx,
                y: rect.y + dy,
                width: Math.max(rect.width - dx * 2)(0),
                height: Math.max(rect.height - dy * 2)(0)
            }
    }

    export clamp_point :: IRect -> IVec2 -> IVec2
    {
        rect => point =>
            if rect.width <= 0 || rect.height <= 0
            then { GameMath.origin(rect) }
            else
            {
                IVec2{
                    x: Math.clamp(point.x)(rect.x)(GameMath.right(rect) - 1),
                    y: Math.clamp(point.y)(rect.y)(GameMath.bottom(rect) - 1)
                }
            }
    }

    export grid_to_screen :: IVec2 -> Int -> IVec2 -> IVec2
    {
        origin => cell_size => coord =>
            IVec2{
                x: origin.x + coord.x * cell_size,
                y: origin.y + coord.y * cell_size
            }
    }

    export grid_rect :: IVec2 -> Int -> IVec2 -> IRect
    {
        origin => cell_size => grid_size =>
            IRect{
                x: origin.x,
                y: origin.y,
                width: grid_size.x * cell_size,
                height: grid_size.y * cell_size
            }
    }

    export grid_cell_rect :: IVec2 -> Int -> Int -> IVec2 -> IRect
    {
        origin => cell_size => shrink => coord => {
            top_left := GameMath.grid_to_screen(origin)(cell_size)(coord);
            IRect{
                x: top_left.x,
                y: top_left.y,
                width: Math.max(cell_size - shrink)(0),
                height: Math.max(cell_size - shrink)(0)
            }
        }
    }

    export origin :: Rect -> Vec2
    {
        rect => Vec2{x: rect.x, y: rect.y}
    }

    export size :: Rect -> Vec2
    {
        rect => Vec2{x: rect.width, y: rect.height}
    }

    export right :: Rect -> Float
    {
        rect => rect.x + rect.width
    }

    export bottom :: Rect -> Float
    {
        rect => rect.y + rect.height
    }

    export center :: Rect -> Vec2
    {
        rect => Vec2{x: rect.x + rect.width / 2.0, y: rect.y + rect.height / 2.0}
    }

    export contains_point :: Rect -> Vec2 -> Bool
    {
        rect => point =>
            point.x >= rect.x &&
            point.x < GameMath.right(rect) &&
            point.y >= rect.y &&
            point.y < GameMath.bottom(rect)
    }

    export intersects :: Rect -> Rect -> Bool
    {
        left => right =>
            left.x < GameMath.right(right) &&
            right.x < GameMath.right(left) &&
            left.y < GameMath.bottom(right) &&
            right.y < GameMath.bottom(left)
    }

    export translate_rect :: Rect -> Vec2 -> Rect
    {
        rect => delta => Rect{x: rect.x + delta.x, y: rect.y + delta.y, width: rect.width, height: rect.height}
    }

    export inflate :: Rect -> Float -> Float -> Rect
    {
        rect => dx => dy =>
            Rect{
                x: rect.x - dx,
                y: rect.y - dy,
                width: rect.width + dx * 2.0,
                height: rect.height + dy * 2.0
            }
    }

    export deflate :: Rect -> Float -> Float -> Rect
    {
        rect => dx => dy => {
            next_width := rect.width - dx * 2.0;
            next_height := rect.height - dy * 2.0;
            Rect{
                x: rect.x + dx,
                y: rect.y + dy,
                width: if next_width >= 0.0 then next_width else 0.0,
                height: if next_height >= 0.0 then next_height else 0.0
            }
        }
    }

    export clamp_point :: Rect -> Vec2 -> Vec2
    {
        rect => point =>
            if rect.width <= 0.0 || rect.height <= 0.0
            then { GameMath.origin(rect) }
            else
            {
                Vec2{
                    x: FloatMath.clamp(point.x)(rect.x)(GameMath.right(rect)),
                    y: FloatMath.clamp(point.y)(rect.y)(GameMath.bottom(rect))
                }
            }
    }

    export EqIVec2 :: instance Traits.Eq {
        eq :: IVec2 -> IVec2 -> Bool
        {
            left => right => left.x == right.x && left.y == right.y
        }
    }

    export EqVec2 :: instance Traits.Eq {
        eq :: Vec2 -> Vec2 -> Bool
        {
            left => right => left.x == right.x && left.y == right.y
        }
    }

    export EqIRect :: instance Traits.Eq {
        eq :: IRect -> IRect -> Bool
        {
            left => right =>
                left.x == right.x &&
                left.y == right.y &&
                left.width == right.width &&
                left.height == right.height
        }
    }

    export EqRect :: instance Traits.Eq {
        eq :: Rect -> Rect -> Bool
        {
            left => right =>
                left.x == right.x &&
                left.y == right.y &&
                left.width == right.width &&
                left.height == right.height
        }
    }

    export CloneIVec2 :: instance Traits.Clone {
        clone :: Ref[IVec2] -> IVec2
        {
            value => *value
        }
    }

    export CloneVec2 :: instance Traits.Clone {
        clone :: Ref[Vec2] -> Vec2
        {
            value => *value
        }
    }

    export CloneIRect :: instance Traits.Clone {
        clone :: Ref[IRect] -> IRect
        {
            value => *value
        }
    }

    export CloneRect :: instance Traits.Clone {
        clone :: Ref[Rect] -> Rect
        {
            value => *value
        }
    }

}
