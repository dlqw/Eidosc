Monoid :: module {
    import Semigroup
    import Traits

    export Monoid :: trait {
        empty :: Unit -> Self
    }

    @[derive(Copy, Clone)]
    export LawUnit :: type { LawUnit :: type {} }

    export law_unit :: Unit -> LawUnit
    {
        _ => LawUnit()
    }

    export EqLawUnit :: instance Traits.Eq {
        eq :: LawUnit -> LawUnit -> Bool
            {
                _ => _ => true
            }
    }

    export empty_int :: Unit -> Int
    {
        _ => 0
    }

    export empty_string :: Unit -> String
    {
        _ => ""
    }

    export empty_seq[T] :: Unit -> Seq[T]
    {
        _ => []
    }

    export is_empty[T: Traits.Eq + Monoid.Monoid] :: T -> Bool
    {
        value => value == Monoid.empty(())
    }

    export combine[T: Semigroup.Semigroup + Monoid.Monoid] :: Seq[T] -> T
    {
        [] => Monoid.empty(()),
        [head, ..tail] => Semigroup.append(head)(Monoid.combine(tail))
    }

    export append :: LawUnit -> LawUnit -> LawUnit
    {
        _ => _ => LawUnit()
    }

    export MonoidDefaults :: instance Monoid.Monoid {
        empty :: Unit -> LawUnit
            {
                _ => LawUnit()
            }
    }

    export inverse :: LawUnit -> LawUnit
    {
        _ => LawUnit()
    }

    export add :: LawUnit -> LawUnit -> LawUnit
    {
        _ => _ => LawUnit()
    }

    export zero :: Unit -> LawUnit
    {
        _ => LawUnit()
    }

    export negate :: LawUnit -> LawUnit
    {
        _ => LawUnit()
    }

    export multiply :: LawUnit -> LawUnit -> LawUnit
    {
        _ => _ => LawUnit()
    }

    export one :: Unit -> LawUnit
    {
        _ => LawUnit()
    }

    export MonoidInt :: instance Monoid.Monoid {
        empty :: Unit -> Int
            {
                _ => Monoid.empty_int(())
            }
    }

    export MonoidString :: instance Monoid.Monoid {
        empty :: Unit -> String
            {
                _ => Monoid.empty_string(())
            }
    }

    export MonoidSeq[T] :: instance Monoid.Monoid {
        empty[T] :: Unit -> Seq[T]
            {
                _ => Monoid.empty_seq(())
            }
    }

}
