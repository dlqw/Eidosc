Alternative :: module {
    import Option

    export Alternative[F: kind2] :: trait {
        empty[A] :: Unit -> F[A] compiler(role: "elaborator.do.empty")
        or_else[A] :: F[A] -> F[A] -> F[A]
    }

    export empty_seq[A] :: Unit -> Seq[A]
    {
        _ => []
    }

    export is_empty[A] :: Seq[A] -> Bool
    {
        [] => true,
        xs => false
    }

    export or_else_with[A, E: effects] :: Seq[A] -> (Unit -> Seq[A] need E) -> Seq[A] need E
    {
        [] => fallback => fallback(()),
        xs => _ => xs
    }

    export guard_seq :: Bool -> Seq[Unit]
    {
        true => [()],
        false => []
    }

    export when_seq[A, E: effects] :: Bool -> (Unit -> A need E) -> Seq[A] need E
    {
        true => body => [body(())],
        false => _ => []
    }

    export empty_option[A] :: Unit -> Option[A]
    {
        _ => None()
    }

    export is_empty[A] :: Option[A] -> Bool
    {
        Some(value) => false,
        None() => true
    }

    export or_else_with[A, E: effects] :: Option[A] -> (Unit -> Option[A] need E) -> Option[A] need E
    {
        Some(value) => _ => Some(value),
        None() => fallback => fallback(())
    }

    export guard_option :: Bool -> Option[Unit]
    {
        true => Some(()),
        false => None()
    }

    export when_option[A, E: effects] :: Bool -> (Unit -> A need E) -> Option[A] need E
    {
        true => body => Some(body(())),
        false => _ => None()
    }

    export empty_for[A, F: kind2 : Alternative[F]] :: Unit -> F[A]
    {
        _ => Alternative.empty(())
    }

    export choose[A, F: kind2 : Alternative[F]] :: F[A] -> F[A] -> F[A]
    {
        values => fallback => Alternative.or_else(values)(fallback)
    }

    export AlternativeSeq :: instance Alternative.Alternative[Seq] {
        empty[A] :: Unit -> Seq[A]
            {
                _ => []
            }
        or_else[A] :: Seq[A] -> Seq[A] -> Seq[A]
            {
                [] => fallback => fallback,
                xs => _ => xs
            }
    }

    export AlternativeOption :: instance Alternative.Alternative[Option] {
        empty[A] :: Unit -> Option[A]
            {
                _ => None()
            }
        or_else[A] :: Option[A] -> Option[A] -> Option[A]
            {
                Some(value) => _ => Some(value),
                None() => fallback => fallback
            }
    }
}
