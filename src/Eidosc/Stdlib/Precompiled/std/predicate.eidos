Predicate :: module {
    import Traits
    import TraitInvoke

    export accept[A, E: effects] :: (A -> Bool need E) -> A -> Bool need E
    {
        predicate, value => value |> predicate
    }

    export reject[A, E: effects] :: (A -> Bool need E) -> A -> Bool need E
    {
        predicate, value => !(value |> predicate)
    }

    export is[A: Traits.Eq] :: A -> A -> Bool
    {
        expected => value => value == expected
    }

    export is_not[A: Traits.Eq] :: A -> A -> Bool
    {
        expected => value => !(value == expected)
    }

    export both[A: Traits.Clone, E1: effects, E2: effects] :: (A -> Bool need E1) -> (A -> Bool need E2) -> A -> Bool need E1, E2
    {
        left => right => value => {
            copied := TraitInvoke.clone_value(ref value);
            if value |> left then { copied |> right } else { false }
        }
    }

    export either[A: Traits.Clone, E1: effects, E2: effects] :: (A -> Bool need E1) -> (A -> Bool need E2) -> A -> Bool need E1, E2
    {
        left => right => value => {
            copied := TraitInvoke.clone_value(ref value);
            if value |> left then { true } else { copied |> right }
        }
    }
}
