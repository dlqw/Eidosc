Ffi :: module {
    // C 标准内存管理



    ptr_null :: Unit -> RawPtr compiler(internal, intrinsic: "ptr_null");




    ptr_is_null :: RawPtr -> Bool compiler(internal, intrinsic: "ptr_is_null");




    ptr_equals :: RawPtr -> RawPtr -> Bool compiler(internal, intrinsic: "ptr_equals");





    ptr_add :: RawPtr -> Int -> RawPtr compiler(internal, intrinsic: "ptr_add") need ffi;

    ptr_to_int :: RawPtr -> Int compiler(internal, intrinsic: "ptr_to_int") need ffi;

    int_to_ptr :: Int -> RawPtr compiler(internal, intrinsic: "int_to_ptr") need ffi;

    float_to_int :: Float -> Int compiler(internal, intrinsic: "float_to_int") need ffi;





    ptr_load_int :: RawPtr -> Int compiler(internal, intrinsic: "ptr_load_int") need ffi;





    ptr_store_int :: RawPtr -> Int -> Unit compiler(internal, intrinsic: "ptr_store_int") need ffi;





    ptr_load_float :: RawPtr -> Float compiler(internal, intrinsic: "ptr_load_float") need ffi;





    ptr_load_ptr :: RawPtr -> RawPtr compiler(internal, intrinsic: "ptr_load_ptr") need ffi;






    ptr_load_i32 :: RawPtr -> Int compiler(internal, intrinsic: "ptr_load_i32") need ffi compiler(llvm_abi: "ptr -> i32");






    ptr_load_i8 :: RawPtr -> Int compiler(internal, intrinsic: "ptr_load_i8") need ffi compiler(llvm_abi: "ptr -> i8");





    ptr_load_bool :: RawPtr -> Bool compiler(internal, intrinsic: "ptr_load_bool") need ffi;

    // C 定宽元素的类型化加载（C2E 下标/解引用按元素宽度选择）：
    // i16/f32 加载后拓宽（zext/fpext）到 Eidos Int/Float（i64/f64）。
    ptr_load_i16 :: RawPtr -> Int compiler(internal, intrinsic: "ptr_load_i16") need ffi compiler(llvm_abi: "ptr -> i16");

    ptr_load_f32 :: RawPtr -> Float compiler(internal, intrinsic: "ptr_load_f32") need ffi compiler(llvm_abi: "ptr -> float");





    ptr_store_float :: RawPtr -> Float -> Unit compiler(internal, intrinsic: "ptr_store_float") need ffi;





    ptr_store_ptr :: RawPtr -> RawPtr -> Unit compiler(internal, intrinsic: "ptr_store_ptr") need ffi;






    ptr_store_i32 :: RawPtr -> Int -> Unit compiler(internal, intrinsic: "ptr_store_i32") need ffi compiler(llvm_abi: "ptr, i32 -> void");






    ptr_store_i8 :: RawPtr -> Int -> Unit compiler(internal, intrinsic: "ptr_store_i8") need ffi compiler(llvm_abi: "ptr, i8 -> void");





    ptr_store_bool :: RawPtr -> Bool -> Unit compiler(internal, intrinsic: "ptr_store_bool") need ffi;

    ptr_store_i16 :: RawPtr -> Int -> Unit compiler(internal, intrinsic: "ptr_store_i16") need ffi compiler(llvm_abi: "ptr, i16 -> void");

    ptr_store_f32 :: RawPtr -> Float -> Unit compiler(internal, intrinsic: "ptr_store_f32") need ffi compiler(llvm_abi: "ptr, float -> void");





    ptr_load_as[T] :: RawPtr -> T compiler(internal, intrinsic: "ptr_load_as") need ffi;





    ptr_store_as[T] :: RawPtr -> T -> Unit compiler(internal, intrinsic: "ptr_store_as") need ffi;





    export cfn_from[R] :: (Unit -> R) -> Cfn[R] compiler(intrinsic: "cfn_from") need ffi;
    export cfn_from[A, R] :: (A -> R) -> Cfn[A, R] compiler(intrinsic: "cfn_from") need ffi;
    export cfn_from[A, B, R] :: (A -> B -> R) -> Cfn[A, B, R] compiler(intrinsic: "cfn_from") need ffi;
    export cfn_from[A, B, C, R] :: (A -> B -> C -> R) -> Cfn[A, B, C, R] compiler(intrinsic: "cfn_from") need ffi;
    export cfn_from[A, B, C, D, R] :: (A -> B -> C -> D -> R) -> Cfn[A, B, C, D, R] compiler(intrinsic: "cfn_from") need ffi;
    export cfn_from[A, B, C, D, E, R] :: (A -> B -> C -> D -> E -> R) -> Cfn[A, B, C, D, E, R] compiler(intrinsic: "cfn_from") need ffi;
    export cfn_from[A, B, C, D, E, F, R] :: (A -> B -> C -> D -> E -> F -> R) -> Cfn[A, B, C, D, E, F, R] compiler(intrinsic: "cfn_from") need ffi;

    export cfn_call[R] :: Cfn[R] -> R compiler(intrinsic: "cfn_call") need ffi;
    export cfn_call[A, R] :: Cfn[A, R] -> A -> R compiler(intrinsic: "cfn_call") need ffi;
    export cfn_call[A, B, R] :: Cfn[A, B, R] -> A -> B -> R compiler(intrinsic: "cfn_call") need ffi;
    export cfn_call[A, B, C, R] :: Cfn[A, B, C, R] -> A -> B -> C -> R compiler(intrinsic: "cfn_call") need ffi;
    export cfn_call[A, B, C, D, R] :: Cfn[A, B, C, D, R] -> A -> B -> C -> D -> R compiler(intrinsic: "cfn_call") need ffi;
    export cfn_call[A, B, C, D, E, R] :: Cfn[A, B, C, D, E, R] -> A -> B -> C -> D -> E -> R compiler(intrinsic: "cfn_call") need ffi;
    export cfn_call[A, B, C, D, E, F, R] :: Cfn[A, B, C, D, E, F, R] -> A -> B -> C -> D -> E -> F -> R compiler(intrinsic: "cfn_call") need ffi;

    // ctx-pointer 约定回调：闭包 invoke thunk 的 ABI 恰为 (closure_ptr, args...)，
    // 与 C 侧 callback(void* ctx, args...) 同构。cfn_ctx_from 取 invoke_fn 作为
    // 回调指针（ctx 槽位前置），cfn_ctx_data 取闭包对象指针作为 ctx。
    // 闭包生命周期由调用方保证（C 侧注册期间不得释放）。
    export cfn_ctx_from[R] :: (Unit -> R) -> Cfn[RawPtr, R] compiler(intrinsic: "cfn_ctx_from") need ffi;
    export cfn_ctx_from[A, R] :: (A -> R) -> Cfn[RawPtr, A, R] compiler(intrinsic: "cfn_ctx_from") need ffi;
    export cfn_ctx_from[A, B, R] :: (A -> B -> R) -> Cfn[RawPtr, A, B, R] compiler(intrinsic: "cfn_ctx_from") need ffi;
    export cfn_ctx_from[A, B, C, R] :: (A -> B -> C -> R) -> Cfn[RawPtr, A, B, C, R] compiler(intrinsic: "cfn_ctx_from") need ffi;
    export cfn_ctx_from[A, B, C, D, R] :: (A -> B -> C -> D -> R) -> Cfn[RawPtr, A, B, C, D, R] compiler(intrinsic: "cfn_ctx_from") need ffi;
    export cfn_ctx_from[A, B, C, D, E, R] :: (A -> B -> C -> D -> E -> R) -> Cfn[RawPtr, A, B, C, D, E, R] compiler(intrinsic: "cfn_ctx_from") need ffi;
    export cfn_ctx_from[A, B, C, D, E, F, R] :: (A -> B -> C -> D -> E -> F -> R) -> Cfn[RawPtr, A, B, C, D, E, F, R] compiler(intrinsic: "cfn_ctx_from") need ffi;

    export cfn_ctx_data[R] :: (Unit -> R) -> RawPtr compiler(intrinsic: "cfn_ctx_data") need ffi;
    export cfn_ctx_data[A, R] :: (A -> R) -> RawPtr compiler(intrinsic: "cfn_ctx_data") need ffi;
    export cfn_ctx_data[A, B, R] :: (A -> B -> R) -> RawPtr compiler(intrinsic: "cfn_ctx_data") need ffi;
    export cfn_ctx_data[A, B, C, R] :: (A -> B -> C -> R) -> RawPtr compiler(intrinsic: "cfn_ctx_data") need ffi;
    export cfn_ctx_data[A, B, C, D, R] :: (A -> B -> C -> D -> R) -> RawPtr compiler(intrinsic: "cfn_ctx_data") need ffi;
    export cfn_ctx_data[A, B, C, D, E, R] :: (A -> B -> C -> D -> E -> R) -> RawPtr compiler(intrinsic: "cfn_ctx_data") need ffi;
    export cfn_ctx_data[A, B, C, D, E, F, R] :: (A -> B -> C -> D -> E -> F -> R) -> RawPtr compiler(intrinsic: "cfn_ctx_data") need ffi;



    string_to_cstr :: String -> RawPtr compiler(internal, intrinsic: "string_to_cstr") need ffi;



    cstr_to_string :: RawPtr -> String compiler(internal, intrinsic: "cstr_to_string") need ffi;



    @[extern(c, name: "malloc")]
    export malloc :: Int -> RawPtr need ffi;



    @[extern(c, name: "free")]
    export free :: RawPtr -> Unit need ffi;



    @[extern(c, name: "calloc")]
    export calloc :: Int -> Int -> RawPtr need ffi;



    @[extern(c, name: "realloc")]
    export realloc :: RawPtr -> Int -> RawPtr need ffi;



    @[extern(c, name: "memcpy")]
    export memcpy :: RawPtr -> RawPtr -> Int -> RawPtr need ffi;



    @[extern(c, name: "memset")]
    export memset :: RawPtr -> Int -> Int -> RawPtr need ffi;





    value_box[A] :: A -> RawPtr compiler(internal, intrinsic: "value_box") need ffi;





    value_unbox[A] :: RawPtr -> A compiler(internal, intrinsic: "value_unbox") need ffi;





    value_box_free :: RawPtr -> Unit compiler(internal, intrinsic: "value_box_free") need ffi;


    export is_null :: RawPtr -> Bool need ffi
    {
        ptr => ptr_is_null(ptr)
    }

    export null_pointer :: Unit -> RawPtr
    {
        _ => ptr_null()
    }

    export pointer_eq :: RawPtr -> RawPtr -> Bool
    {
        left => right => ptr_equals(left)(right)
    }

    export offset_bytes :: RawPtr -> Int -> RawPtr need ffi
    {
        ptr => byte_offset => ptr_add(ptr)(byte_offset)
    }

    export load[T] :: RawPtr -> T need ffi
    {
        ptr => ptr_load_as[T](ptr)
    }

    export store[T] :: RawPtr -> T -> Unit need ffi
    {
        ptr => value => ptr_store_as[T](ptr)(value)
    }

    // 按宽度命名的指针读写（C int/short/char/float 元素）：
    // Ffi.load[Int]/store[Int] 是 i64 存取，C 定宽元素必须用对应宽度变体，
    // 否则相邻元素会被跨写/读到合并值。
    // 指针↔整数（ptrdiff 算术）与 C 截断语义的 Float→Int（fptosi，向零截断）。
    export ptr_as_int :: RawPtr -> Int need ffi
    {
        p => ptr_to_int(p)
    }

    // 整数位模式回指针（C 的 (T*)n，如 Win32 MAKEINTRESOURCE 资源句柄形态）。
    export int_as_ptr :: Int -> RawPtr need ffi
    {
        v => int_to_ptr(v)
    }

    export trunc_to_int :: Float -> Int need ffi
    {
        v => float_to_int(v)
    }

    export load_i32 :: RawPtr -> Int need ffi
    {
        ptr => ptr_load_i32(ptr)
    }

    export store_i32 :: RawPtr -> Int -> Unit need ffi
    {
        ptr => value => ptr_store_i32(ptr)(value)
    }

    export load_i16 :: RawPtr -> Int need ffi
    {
        ptr => ptr_load_i16(ptr)
    }

    export store_i16 :: RawPtr -> Int -> Unit need ffi
    {
        ptr => value => ptr_store_i16(ptr)(value)
    }

    export load_i8 :: RawPtr -> Int need ffi
    {
        ptr => ptr_load_i8(ptr)
    }

    export store_i8 :: RawPtr -> Int -> Unit need ffi
    {
        ptr => value => ptr_store_i8(ptr)(value)
    }

    export load_f32 :: RawPtr -> Float need ffi
    {
        ptr => ptr_load_f32(ptr)
    }

    export store_f32 :: RawPtr -> Float -> Unit need ffi
    {
        ptr => value => ptr_store_f32(ptr)(value)
    }

    export to_c_string :: String -> RawPtr need ffi
    {
        text => string_to_cstr(text)
    }

    export from_c_string :: RawPtr -> String need ffi
    {
        ptr => cstr_to_string(ptr)
    }

    export is_non_null :: RawPtr -> Bool need ffi
    {
        ptr => !ptr_is_null(ptr)
    }

    export free_if_non_null :: RawPtr -> Unit need ffi
    {
        ptr => if ptr_is_null(ptr) then { () } else { Ffi.free(ptr) }
    }

    export alloc_or_null :: Int -> RawPtr need ffi
    {
        size => if size <= 0 then { ptr_null() } else { Ffi.malloc(size) }
    }

    export zero_memory :: RawPtr -> Int -> RawPtr need ffi
    {
        ptr => size => if size <= 0 then { ptr } else { Ffi.memset(ptr)(0)(size) }
    }

    export copy_memory :: RawPtr -> RawPtr -> Int -> RawPtr need ffi
    {
        dest => src => size => if size <= 0 then { dest } else { Ffi.memcpy(dest)(src)(size) }
    }

    export box_value[A] :: A -> RawPtr need ffi
    {
        value => value_box(value)
    }

    export unbox_value[A] :: RawPtr -> A need ffi
    {
        ptr => value_unbox(ptr)
    }

    export free_boxed_value :: RawPtr -> Unit need ffi
    {
        ptr => value_box_free(ptr)
    }

    // 安全包装：分配 + 自动释放

    export with_malloc[A, E: effects] :: Int -> (RawPtr -> A need E) -> A need ffi, E
    {
        size => body => {
            ptr := Ffi.malloc(size);
            result := body(ptr);
            Ffi.free(ptr);
            result
        }
    }

    export with_malloc_zeroed[A, E: effects] :: Int -> (RawPtr -> A need E) -> A need ffi, E
    {
        size => body => {
            ptr := Ffi.calloc(1)(size);
            result := body(ptr);
            Ffi.free(ptr);
            result
        }
    }

    export with_calloc[A, E: effects] :: Int -> Int -> (RawPtr -> A need E) -> A need ffi, E
    {
        count => size => body => {
            ptr := Ffi.calloc(count)(size);
            result := body(ptr);
            Ffi.free(ptr);
            result
        }
    }
}
