<Project>
  <Import Project="$(MSBuildThisFileDirectory)Eidos.Version.props" />
  <PropertyGroup>
    <EidosBindgenVersion>$(EidosVersion)</EidosBindgenVersion>
    <Version>$(EidosVersion)</Version>
    <AssemblyVersion>$(EidosAssemblyVersion)</AssemblyVersion>
    <FileVersion>$(EidosAssemblyVersion)</FileVersion>
    <InformationalVersion>$(EidosVersion)</InformationalVersion>
  </PropertyGroup>
</Project>
